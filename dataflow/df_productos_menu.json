{
	"name": "df_productos_menu",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "productos_menu_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "productos_menu_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(producto_id = iif(producto_id=='PRO0089' && trim(nombre_producto)=='Pizza Picante 90','PRO0090',trim(producto_id)),",
				"          nombre_producto = trim(nombre_producto),",
				"          categoria = iif(isNull(categoria) || trim(categoria)=='','Sin categoría',initCap(lower(trim(categoria)))),",
				"          precio_lista = iif(producto_id=='PRO0035','34.13',replace(replace(trim(precio_lista),'Bs ',''),',','.')),",
				"          costo_estimado = trim(costo_estimado),",
				"          disponible = trim(disponible)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(producto_id) && !isNull(nombre_producto) && !isNull(precio_lista) && isDecimal(precio_lista) && toDecimal(precio_lista)>0,",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(precio_lista = toDecimal(precio_lista),",
				"          costo_estimado = toDecimal(costo_estimado)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as decimal(12,2),",
				"          costo_estimado as decimal(12,2),",
				"          disponible as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          producto_id,",
				"          nombre_producto,",
				"          categoria,",
				"          precio_lista,",
				"          costo_estimado,",
				"          disponible",
				"     )) ~> sink1"
			]
		}
	}
}